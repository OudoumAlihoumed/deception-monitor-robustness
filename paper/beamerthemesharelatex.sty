% Minimal ShareLaTeX-style beamer poster theme (Overleaf-compatible)
\ProvidesPackage{beamerthemesharelatex}[2011/01/20]
\mode<presentation>
\usecolortheme{default}
\usefonttheme{serif}

\setbeamercolor{title}{fg=white,bg=blue!65!black}
\setbeamercolor{frametitle}{fg=white,bg=blue!65!black}
\setbeamercolor{structure}{fg=blue!65!black}
\setbeamercolor{block title}{fg=white,bg=blue!65!black}
\setbeamercolor{block body}{fg=black,bg=blue!5}

\setbeamerfont{title}{size=\Huge,series=\bfseries}
\setbeamerfont{author}{size=\Large}
\setbeamerfont{institute}{size=\large}
\setbeamerfont{date}{size=\large}

\setbeamertemplate{navigation symbols}{}

\setbeamertemplate{block begin}{
  \par\vskip\medskipamount%
  \leavevmode%
  \begin{beamercolorbox}[ht=3.2ex,dp=0.4ex,left,leftskip=1em,colsep*=.75ex]{block title}%
    \usebeamerfont*{block title}\insertblocktitle%
  \end{beamercolorbox}%
  {\parskip0pt\par}%
  \usebeamercolor[bg]{block body}%
  \begin{beamercolorbox}[left,leftskip=1em,rightskip=1em,vmode]{block body}%
    \ifbeamercolorempty[bg]{block body}{}{\vskip-.25ex}\vbox{}%
}
\setbeamertemplate{block end}{\end{beamercolorbox}\vskip\smallskipamount}

\setbeamertemplate{itemize item}{\textbullet}
\setbeamertemplate{itemize subitem}{\textendash}
